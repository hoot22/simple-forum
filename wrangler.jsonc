{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simple-forum",
  "pages_build_output_dir": "public",
  "compatibility_date": "2024-11-01",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "users",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
